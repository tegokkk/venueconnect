POSTGRES_USER="venueconnect"
POSTGRES_PASSWORD="replace-with-a-random-local-password"
POSTGRES_DB="venueconnect_db"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://venueconnect:replace-with-a-random-local-password@localhost:5432/venueconnect_db?schema=public"
# Set a unique random value for this local environment; never reuse the placeholder.
AUTH_SECRET=""
# Isi hanya pada environment backend; jangan salin ke NEXT_PUBLIC_*.
GEMINI_API_KEY=""
AI_ASSISTANT_ENABLED="false"
# Set true only when a shared rate limiter is enforced by the deployment gateway.
AI_RATE_LIMITING_CONFIGURED="false"
APP_BASE_URL="http://localhost:3001"
# Local private storage and student PDF routes are development-only.
# Production always rejects the development session and local storage provider.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage/private"
# Project development baseline enforced in code: one application/pdf, max 5 MB.
# Institutional retention, backup, and production object storage still require approval.
